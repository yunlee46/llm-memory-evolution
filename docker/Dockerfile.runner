# Scoring container. Built once, run with --network none per evaluation.
#
#   docker build -f docker/Dockerfile.runner -t llm-memory-evolution-runner:latest .
#
# pytest is baked in because the container has no network at run time.
FROM python:3.12-slim

RUN pip install --no-cache-dir pytest==8.3.4

# Agent-generated code must not run as root.
RUN useradd --create-home --uid 1000 runner
USER runner

WORKDIR /work
